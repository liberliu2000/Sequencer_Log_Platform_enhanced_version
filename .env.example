# =========================
# 基础运行配置
# =========================
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# =========================
# 数据与目录
# =========================
DATABASE_URL=sqlite:///./data/sequencer_log_platform.db
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
EXPORT_DIR=./data/exports
LOG_DIR=./data/runtime_logs
INTERMEDIATE_CACHE_DIR=./data/intermediate_cache
TEMP_DIR=./data/tmp

# =========================
# 上传与读取
# =========================
MAX_UPLOAD_MB=512
CHUNK_SIZE=65536

# =========================
# 并行/调度
# =========================
ENABLE_PARALLEL_PARSE=true
ENABLE_THREADED_PRESCAN=true
ENABLE_MULTIPROCESS_PARSE=true
ENABLE_STAGED_PARALLEL_PIPELINE=true
ENABLE_PROCESS_POOL=true
ENABLE_STREAMING_PARSE=true
MAX_PARALLEL_CPU_CORES=64
MAX_THREAD_WORKERS=48
MAX_PROCESS_WORKERS=32
MAX_WORKERS=32
FILE_LEVEL_WORKERS=16
PRESCAN_THREAD_WORKERS=32
QUEUE_DISPATCH_WORKERS=8
QUEUE_MAXSIZE=128
PARALLEL_MIN_FILES=3
FILE_SCAN_BATCH_SIZE=200
PARSE_BATCH_SIZE=64
LOAD_BATCH_SIZE=128
STREAMING_PARSE_CHUNK_BYTES=16777216
MAX_PARSE_CHUNKS_PER_FILE=64
METRICS_BATCH_SIZE=256
DB_BATCH_SIZE=5000
FAILED_WORKER_RETRIES=1
SQLITE_WRITE_STRATEGY=main_process_only

# =========================
# 前端/缓存/性能
# =========================
ENABLE_SERVICE_CACHE=true
SERVICE_CACHE_TTL_SECONDS=120
SERVICE_CACHE_MAX_ENTRIES=256
FRONT_PAGE_MAX_ROWS=100
TABLE_PAGE_DEFAULT_SIZE=100
TABLE_PAGE_MAX_SIZE=500
LIGHTWEIGHT_MODE=false
UI_AUTO_REFRESH_SECONDS=5
PERFORMANCE_LOG_ENABLED=true
PROGRESS_PERSIST_INTERVAL_MS=1500
PROGRESS_PERSIST_PERCENT_STEP=2
UNKNOWN_LOG_MAX_SCAN_BYTES=4194304
SYSTEM_MEMORY_SOFT_LIMIT_PERCENT=96
SYSTEM_MEMORY_SOFT_RESERVE_MB=4096
SYSTEM_CPU_SOFT_LIMIT_PERCENT=92
SYSTEM_MEMORY_GUARD_WAIT_SECONDS=5

# =========================
# LLM 诊断与主动学习规则建议
# 注意：learn_parser_rules.py 的 LLM 模式与页面 LLM 诊断共用下面这组配置
# =========================
LLM_ENABLED=false
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_API_KEY=
LLM_MODEL=ep-xxx
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=3

# 规则建议预览（UI / active-learning preview）
# 建议保持短超时、少重试，避免页面等待过久
LLM_PREVIEW_TIMEOUT_SECONDS=12
LLM_PREVIEW_MAX_RETRIES=1
LLM_PREVIEW_CACHE_TTL_SECONDS=600
LLM_PREVIEW_MAX_UNKNOWN_SAMPLES=4
LLM_PREVIEW_MAX_FEEDBACK_SAMPLES=4
LLM_PREVIEW_MAX_PARSER_SNIPPETS=3

# LLM 诊断页面前端等待超时（仅 UI 请求超时，不改变后端保存逻辑）
LLM_DIAGNOSIS_UI_TIMEOUT_SECONDS=120

# 最小必要上下文压缩参数（LLM 诊断用）
LLM_CONTEXT_PRE_LINES=8
LLM_CONTEXT_POST_LINES=8
LLM_CONTEXT_TIME_WINDOW_SECONDS=90
LLM_CONTEXT_RELATED_COMPONENT_LIMIT=30
LLM_CONTEXT_RELATED_CYCLE_LIMIT=30
LLM_CONTEXT_MAX_STACK_FRAMES=8
LLM_CONTEXT_MAX_TOKEN_BUDGET=2200
LLM_CONTEXT_STAGE1_TOKEN_BUDGET=1200

# =========================
# API
# =========================
API_PREFIX=/api/v1
CORS_ALLOW_ORIGINS=*

# =========================
# 鉴权与默认管理员
# =========================
AUTH_SESSION_HOURS=12
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCK_MINUTES=15
AUTH_VERIFICATION_CODE_MINUTES=10
AUTH_VERIFICATION_RESEND_SECONDS=60
AUTH_VERIFICATION_MAX_DAILY_SENDS=10
AUTH_DEFAULT_ADMIN_USERNAME=Yanbo
AUTH_DEFAULT_ADMIN_PASSWORD=MGItech2026

# =========================
# 邮件发送
# smtp 模式用于真实邮箱验证码发送
# console 模式用于本地调试，会把验证码写入日志
# =========================
MAIL_DELIVERY_MODE=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=Sequencer Log Platform
SMTP_USE_TLS=true
SMTP_USE_SSL=false
